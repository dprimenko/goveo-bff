FROM php:8.2-fpm AS builder

ENV COMPOSER_ALLOW_SUPERUSER=1

RUN apt-get update && apt-get install -y \
    git unzip curl libpq-dev libonig-dev zlib1g-dev \
    && docker-php-ext-install pdo pdo_pgsql mbstring opcache \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

COPY docker/php/uploads.ini /usr/local/etc/php/conf.d/uploads.ini
COPY docker/php/zz-docker.conf /usr/local/etc/php-fpm.d/zz-docker.conf

RUN curl -sS https://getcomposer.org/installer | php -- --install-dir=/usr/local/bin --filename=composer

WORKDIR /var/www/html
COPY . .

# `--ignore-platform-req=ext-grpc`: google/cloud-firestore la declara como
# requisito, pero sólo la usa su transporte gRPC y nosotros hablamos por REST
# (ver FirestoreClientFactory). Sin esto, `composer install` falla y la imagen
# ni se construye.
# `--no-scripts` es deliberado: los `@auto-scripts` de Symfony ejecutan
# `cache:clear`, que arranca la aplicación y por tanto lee el `.env`. En el build
# no hay configuración válida —ni base, ni Keycloak, ni las variables reales—, así
# que un valor mal escrito en el panel tumba la construcción de la imagen en vez
# de fallar al arrancar, donde se ve mucho mejor qué ha pasado.
# La caché se genera en el entrypoint, ya con el entorno de verdad.
RUN composer install --no-dev --no-interaction --optimize-autoloader \
    --classmap-authoritative --ignore-platform-req=ext-grpc --no-scripts

FROM php:8.2-fpm AS runtime

# `mbstring` la usa el recorte de textos del mailer; `bcmath` viene de la imagen
# de desarrollo y alguna dependencia la espera. Sin ellas el contenedor arranca y
# falla en caliente, que es peor que fallar al construir.
RUN apt-get update && apt-get install -y libpq-dev libonig-dev \
    && docker-php-ext-install pdo pdo_pgsql opcache mbstring bcmath \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

COPY docker/php/uploads.ini /usr/local/etc/php/conf.d/uploads.ini
COPY docker/php/zz-docker.conf /usr/local/etc/php-fpm.d/zz-docker.conf

WORKDIR /var/www/html
COPY --from=builder /var/www/html .

COPY docker/php/entrypoint.prod.sh /usr/local/bin/entrypoint.sh

# `var/` está en .gitignore, así que no viene en el clon. Antes lo creaba de
# rebote el `cache:clear` de los auto-scripts de composer; ahora que el build no
# arranca la aplicación, hay que crearlo aquí.
RUN mkdir -p /var/www/html/var/cache /var/www/html/var/log \
    && chmod +x /usr/local/bin/entrypoint.sh \
    && chown -R www-data:www-data /var/www/html/var /var/www/html/vendor

EXPOSE 9000
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
CMD ["php-fpm"]
