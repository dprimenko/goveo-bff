#!/usr/bin/env bash
# Túnel SSH hasta el Adminer de un entorno.
#
# Adminer no está publicado en ningún dominio: su puerto está atado al loopback
# del servidor. Este script tiende un túnel hasta él, de forma que la
# herramienta sólo es accesible para quien ya tiene SSH.
#
#   goveo-db open [prod|demo]    abre el túnel y da la URL
#   goveo-db open prod --background   lo deja suelto, como antes
#   goveo-db close [prod|demo]   lo cierra
#   goveo-db status              qué hay abierto
#
# El túnel se queda en primer plano y Ctrl+C lo cierra. Suelto se olvidaba
# abierto: mientras lo esté, cualquier cosa que corra en la máquina llega al
# Adminer de producción por localhost, y cerrar la ventana no lo cerraba. Atarlo
# al terminal hace que el olvido se note. Para lo de antes está `--background`.
#
# Se apoya en una *control socket* de SSH en vez de buscar el proceso con
# `pgrep`: cerrar por PID es frágil —acaba matando otra sesión SSH— y con el
# socket es el propio ssh quien sabe cuál cerrar. Con `--background` sigue siendo
# lo que permite cerrarlo desde otra ventana.
set -euo pipefail

SERVER="${GOVEO_SSH:-root@76.13.63.176}"
SOCKET_DIR="${TMPDIR:-/tmp}/goveo-db"

env_config() {
    # El 8090 y el 8091 se los queda Metro en la app (ver su CLAUDE.md): con el
    # túnel abierto no arrancaba, y con Metro puesto no abría el túnel.
    case "${1:-prod}" in
        prod) REMOTE_PORT=8082; LOCAL_PORT=8095 ;;
        demo) REMOTE_PORT=8083; LOCAL_PORT=8096 ;;
        *) echo "Entorno desconocido: $1 (usa prod o demo)" >&2; exit 1 ;;
    esac
    ENV_NAME="${1:-prod}"
    SOCKET="$SOCKET_DIR/$ENV_NAME.sock"
}

open_tunnel() {
    local detach=0 target=""

    for arg in "$@"; do
        case "$arg" in
            --background|-b) detach=1 ;;
            *) target="$arg" ;;
        esac
    done

    env_config "$target"
    mkdir -p "$SOCKET_DIR"

    if ssh -S "$SOCKET" -O check "$SERVER" 2>/dev/null; then
        echo "Ya estaba abierto → http://localhost:$LOCAL_PORT"
        exit 0
    fi

    # Un socket huérfano (tras reiniciar, o si se perdió la red) impide abrir
    # otro: se limpia antes de intentarlo.
    rm -f "$SOCKET"

    echo "Túnel abierto ($ENV_NAME) → http://localhost:$LOCAL_PORT"
    echo "  servidor: db · usuario y base: los de POSTGRES_USER / POSTGRES_DB"

    if [ "$detach" -eq 1 ]; then
        ssh -M -S "$SOCKET" -fNT \
            -o ExitOnForwardFailure=yes \
            -L "$LOCAL_PORT:127.0.0.1:$REMOTE_PORT" "$SERVER"
        echo "  cerrar:   goveo-db close $ENV_NAME"
        return
    fi

    echo "  cerrar:   Ctrl+C aquí (o goveo-db close $ENV_NAME desde otra ventana)"

    # El socket se queda escrito aunque ssh se vaya por Ctrl+C, y uno viejo
    # impide abrir el siguiente túnel: se borra pase lo que pase.
    trap 'rm -f "$SOCKET"; echo; echo "Túnel cerrado ($ENV_NAME)"' EXIT

    # Sin -f: es lo que ata el túnel a este terminal. `|| true` porque Ctrl+C
    # devuelve 130 y `set -e` lo tomaría por un fallo que anunciar.
    ssh -M -S "$SOCKET" -NT \
        -o ExitOnForwardFailure=yes \
        -L "$LOCAL_PORT:127.0.0.1:$REMOTE_PORT" "$SERVER" || true
}

close_tunnel() {
    env_config "$@"
    if ssh -S "$SOCKET" -O exit "$SERVER" 2>/dev/null; then
        echo "Túnel cerrado ($ENV_NAME)"
    else
        rm -f "$SOCKET"
        echo "No había ningún túnel abierto ($ENV_NAME)"
    fi
}

status() {
    local any=0
    for e in prod demo; do
        env_config "$e"
        if ssh -S "$SOCKET" -O check "$SERVER" 2>/dev/null; then
            echo "  $e → http://localhost:$LOCAL_PORT (abierto)"
            any=1
        fi
    done
    [ "$any" -eq 0 ] && echo "  ningún túnel abierto"
    return 0
}

case "${1:-}" in
    open)   shift; open_tunnel "$@" ;;
    close)  shift; close_tunnel "$@" ;;
    status) status ;;
    *) sed -n '2,14p' "$0" | sed 's/^# \{0,1\}//'; exit 1 ;;
esac
