#!/usr/bin/env bash
# Importa en el servidor la cartelera de El Corte Inglés desde el CSV de Awin.
#
#   goveo-awin ~/Desktop/eci.csv --dry-run     # enseña lo que haría, sin guardar
#   goveo-awin ~/Desktop/eci.csv               # importa: sale en «Sin validar (Scraping)»
#
# Sube el CSV al contenedor de PHP, lanza goveo:events:import-awin y lo borra.
# Repetirlo con un CSV nuevo no duplica nada.
set -euo pipefail

SERVER="${GOVEO_SSH:-root@76.13.63.176}"

if [ $# -eq 0 ] || [ ! -f "$1" ]; then
    echo "Uso: $(basename "$0") <fichero.csv> [opciones]" >&2
    echo "  p. ej. $(basename "$0") ~/Desktop/eci.csv --dry-run" >&2
    exit 1
fi

CSV="$1"; shift


# ── Qué contenedor ──────────────────────────────────────────────────────────
#
# Dokploy le cambia el sufijo en cada redespliegue, así que se busca. Con más de
# uno se para: importar en el entorno equivocado llena otra cola.
CONTENEDOR="${GOVEO_PHP_CONTAINER:-}"

if [ -z "$CONTENEDOR" ]; then
    echo "Buscando el contenedor de PHP en ${SERVER}…"
    if ! CANDIDATOS=$(ssh "$SERVER" "docker ps --format '{{.Names}}' | grep -i php || true"); then
        echo "No se ha podido conectar a ${SERVER}." >&2
        echo "Si entras con otro usuario:  GOVEO_SSH=usuario@servidor $0 …" >&2
        exit 1
    fi

    N=$(printf '%s\n' "$CANDIDATOS" | grep -c . || true)
    if [ "$N" -eq 0 ]; then
        echo "Ningún contenedor de PHP en marcha. Míralos con:" >&2
        echo "  ssh $SERVER docker ps --format '{{.Names}}'" >&2
        exit 1
    fi
    if [ "$N" -gt 1 ]; then
        echo "Hay varios; elige con GOVEO_PHP_CONTAINER=<nombre>:" >&2
        printf '  %s\n' $CANDIDATOS >&2
        exit 1
    fi
    CONTENEDOR="$CANDIDATOS"
fi

echo "Contenedor: $CONTENEDOR"
REMOTO="/tmp/awin-$(date +%s).csv"
scp -q "$CSV" "$SERVER:$REMOTO"
ssh "$SERVER" "docker cp '$REMOTO' '$CONTENEDOR:$REMOTO' && rm -f '$REMOTO'"

echo "Ejecutando goveo:events:import-awin $*"
echo
ssh -t "$SERVER" "docker exec '$CONTENEDOR' php bin/console goveo:events:import-awin '$REMOTO' $*; \
    docker exec '$CONTENEDOR' rm -f '$REMOTO'"
