#!/usr/bin/env bash
# Lanza a mano el scraping de eventos de una ciudad en el servidor.
#
#   goveo-events Madrid --dry-run     # enseña lo que importaría, sin guardar
#   goveo-events Madrid               # importa: salen en «Sin validar (Scraping)»
#   goveo-events Madrid --source=berlin --details
#
# Es el mismo comando que irá en el cron de Dokploy; esto es para lanzarlo
# cuando se quiera mientras el cron no esté puesto. Repetirlo no duplica nada:
# lo ya importado —también lo descartado en el panel— no se vuelve a crear.
set -euo pipefail

SERVER="${GOVEO_SSH:-root@76.13.63.176}"

if [ $# -eq 0 ]; then
    echo "Uso: $(basename "$0") <ciudad> [opciones]" >&2
    echo "  p. ej. $(basename "$0") Madrid --dry-run" >&2
    exit 1
fi

CIUDAD="$1"; shift

# ── Qué contenedor ──────────────────────────────────────────────────────────
#
# Dokploy le cambia el sufijo en cada redespliegue, así que se busca. Con más de
# uno se para: importar en el entorno equivocado llena otra cola.
CONTENEDOR="${GOVEO_PHP_CONTAINER:-}"

if [ -z "$CONTENEDOR" ]; then
    echo "Buscando el contenedor de PHP en ${SERVER}…"
    if ! CANDIDATOS=$(ssh "$SERVER" "docker ps --format '{{.Names}}' | grep -i php || true"); then
        echo "No se ha podido conectar a ${SERVER}." >&2
        echo "Si entras con otro usuario:  GOVEO_SSH=usuario@servidor $0 …" >&2
        exit 1
    fi

    N=$(printf '%s\n' "$CANDIDATOS" | grep -c . || true)
    if [ "$N" -eq 0 ]; then
        echo "Ningún contenedor de PHP en marcha. Míralos con:" >&2
        echo "  ssh $SERVER docker ps --format '{{.Names}}'" >&2
        exit 1
    fi
    if [ "$N" -gt 1 ]; then
        echo "Hay varios; elige con GOVEO_PHP_CONTAINER=<nombre>:" >&2
        printf '  %s\n' $CANDIDATOS >&2
        exit 1
    fi
    CONTENEDOR="$CANDIDATOS"
fi

echo "Contenedor: $CONTENEDOR"
echo "Ejecutando goveo:events:scrape --city=$CIUDAD $*"
echo

# La pasada del Ayuntamiento tarda varios minutos: `-t` para ver el progreso y
# poder cortarla con Ctrl-C.
ssh -t "$SERVER" "docker exec '$CONTENEDOR' \
    php bin/console goveo:events:scrape --city='$CIUDAD' $*"
