FIREBASE_CREDENTIALS=/var/www/html/config/firebase-credentials.json
FIREBASE_PROJECT_ID=goveoapp-fd8b1
###< firebase / firestore — data migration ###

###> supabase — data migration source ###
# postgresql://user:password@db.xxxx.supabase.co:5432/postgres
SUPABASE_DATABASE_URL=
###< supabase — data migration source ###

