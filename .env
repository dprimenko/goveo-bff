# Valores por defecto para desarrollo. **Este fichero está versionado:
# no pongas secretos aquí.** Lo real va en `.env.local` (ignorado por git)
# y, en los entornos desplegados, en el panel de Dokploy.

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=ch4ng3_m3_t0_s0m3th1ng_r4nd0m_1n_pr0duct10n
APP_DOMAIN=localhost
APP_URL=http://localhost:4321
###< symfony/framework-bundle ###

###> doctrine/doctrine-bundle ###
DATABASE_URL="postgresql://goveo:goveo_pass@db:5432/goveo?serverVersion=16&charset=utf8"
###< doctrine/doctrine-bundle ###

###> nelmio/cors-bundle ###
CORS_ALLOW_ORIGIN='^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$'
###< nelmio/cors-bundle ###

###> keycloak ###
KEYCLOAK_URL=http://keycloak:8080
KEYCLOAK_PUBLIC_URL=http://localhost:8081
KEYCLOAK_REALM=goveo
KEYCLOAK_CLIENT_ID=goveo-app
KEYCLOAK_CLIENT_SECRET=goveo-client-secret
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin123
###< keycloak ###

###> firebase / firestore — data migration ###
