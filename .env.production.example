APP_ENV=prod
APP_SECRET=<CHANGE_ME_RANDOM_64_CHAR_STRING>
APP_DOMAIN=<your-domain.com>
APP_URL=https://<your-domain.com>

DATABASE_URL="postgresql://<user>:<password>@<host>:5432/<db>?serverVersion=16&charset=utf8"

# ⚠️ En Dokploy va **sin comillas**: si se guardan, el regex se compila con ellas
# dentro y no casa con ningún origen — nelmio responde al preflight pero sin
# `Access-Control-Allow-Origin`, y el navegador lo corta con «Failed to fetch».
# `goveo.app` **sin www** es el de la web pública, y es el que usa el formulario
# de alta (`/alta`): dejarlo fuera lo rompe sin tocarlo.
CORS_ALLOW_ORIGIN='^https://(goveo\.app|www\.goveo\.app|app\.goveo\.app|admin\.goveo\.app)$'

KEYCLOAK_URL=https://<keycloak-internal-host>:8080
KEYCLOAK_PUBLIC_URL=https://auth.<your-domain.com>
KEYCLOAK_REALM=goveo
KEYCLOAK_CLIENT_ID=goveo-app
KEYCLOAK_CLIENT_SECRET=<CHANGE_ME>
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=<CHANGE_ME>

GOOGLE_SOCIAL_CLIENT_ID=
GOOGLE_SOCIAL_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# Audiencias aceptadas al verificar un token social por nuestra cuenta, separadas
# por comas (los client id de iOS, Android y web). Vacías, vale cualquier cliente
# del mismo proyecto que GOOGLE_SOCIAL_CLIENT_ID / APPLE_CLIENT_ID, que es lo
# normal. Sólo se usan al vincular una cuenta antigua con su proveedor.
GOOGLE_ALLOWED_AUDIENCES=
APPLE_ALLOWED_AUDIENCES=

MAILER_DSN=smtps://<user>:<password>@smtp.example.com:465
# Sólo la dirección: el nombre visible («Goveo») lo pone el código, porque un
# valor con espacios hay que entrecomillarlo y hay paneles que quitan las
# comillas al guardar, dejando un .env que Symfony no puede leer.
EMAIL_FROM=hola@goveo.app

FIREBASE_PROJECT_ID=
FIREBASE_CREDENTIALS_JSON=

# A dónde avisar cuando entra algo nuevo en la cola del panel (negocio o vídeo).
# Vacío = no se avisa.
REVIEW_EMAIL=hola@goveo.app
# Para poder enlazar la ficha desde ese aviso.
BACKOFFICE_URL=https://admin.goveo.app

# Botón «Entrar en mi cuenta» de los correos de aprobación: abre la app, o lleva
# a su tienda si no está instalada. Se puede dejar sin poner (hay valor por
# defecto en services.yaml); sólo cambia si se rehace el enlace en Branch.
APP_LINK_URL=https://links.goveo.app/1GHor7ffjWb

# Orígenes del panel para el cliente de Keycloak (separados por espacios).
# Sin localhost en producción.
GOVEO_BACKOFFICE_ORIGINS=https://admin.goveo.app
