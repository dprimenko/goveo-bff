APP_ENV=prod
APP_SECRET=<CHANGE_ME_RANDOM_64_CHAR_STRING>
APP_DOMAIN=<your-domain.com>
APP_URL=https://<your-domain.com>

DATABASE_URL="postgresql://<user>:<password>@<host>:5432/<db>?serverVersion=16&charset=utf8"

CORS_ALLOW_ORIGIN='^https://(app\.goveo\.app|www\.goveo\.app)$'

KEYCLOAK_URL=https://<keycloak-internal-host>:8080
KEYCLOAK_PUBLIC_URL=https://auth.<your-domain.com>
KEYCLOAK_REALM=goveo
KEYCLOAK_CLIENT_ID=goveo-app
KEYCLOAK_CLIENT_SECRET=<CHANGE_ME>
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=<CHANGE_ME>

GOOGLE_SOCIAL_CLIENT_ID=
GOOGLE_SOCIAL_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# Audiencias aceptadas al verificar un token social por nuestra cuenta, separadas
# por comas (los client id de iOS, Android y web). Vacías, vale cualquier cliente
# del mismo proyecto que GOOGLE_SOCIAL_CLIENT_ID / APPLE_CLIENT_ID, que es lo
# normal. Sólo se usan al vincular una cuenta antigua con su proveedor.
GOOGLE_ALLOWED_AUDIENCES=
APPLE_ALLOWED_AUDIENCES=

MAILER_DSN=smtps://<user>:<password>@smtp.example.com:465
EMAIL_FROM="Goveo <noreply@goveo.app>"

FIREBASE_PROJECT_ID=
FIREBASE_CREDENTIALS_JSON=

# A dónde avisar cuando entra algo nuevo en la cola del panel (negocio o vídeo).
# Vacío = no se avisa.
REVIEW_EMAIL=hola@goveo.app
# Para poder enlazar la ficha desde ese aviso.
BACKOFFICE_URL=https://admin.goveo.app
